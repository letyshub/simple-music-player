{
  "name": "simple-music-player",
  "version": "1.1.0",
  "description": "Prosty odtwarzacz MP3 w stylu wiezy hi-fi z lat 90.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run icon && electron-builder --win --publish never",
    "pack": "npm run icon && electron-builder --win --dir",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "test:packaged": "node tests/smoke/packaged.mjs",
    "icon": "node tools/make-icon.mjs",
    "release": "npm run icon && electron-builder --win --publish always"
  },
  "author": "letyshub",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^11.12.3"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "pl.local.simplemusicplayer",
    "productName": "Simple Music Player",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Simple Music Player",
      "artifactName": "SimpleMusicPlayer-${version}-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "portable": {
      "artifactName": "SimpleMusicPlayer-${version}-portable.${ext}"
    },
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/letyshub/simple-music-player.git"
  },
  "homepage": "https://github.com/letyshub/simple-music-player",
  "bugs": {
    "url": "https://github.com/letyshub/simple-music-player/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
